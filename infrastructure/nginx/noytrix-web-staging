server {
    listen 8100;
    listen [::]:8100;
    server_name _;

    root /var/www/noytrix-staging;
    index index.html;

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    # The raw-IP preview deliberately exposes only public scan functionality.
    # Account, entitlement and billing routes must wait for HTTPS on a named
    # staging domain; credentials must never transit this preview over HTTP.
    location = /scan {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
    }

    # Staging-only interactive scan workspace. SSE buffering is disabled so
    # users see each verified analysis stage as the staging API emits it.
    location ^~ /workspace/ {
        proxy_pass http://127.0.0.1:8025;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        add_header Cache-Control "no-store" always;
    }

    # Public, read-only intelligence data for the staging UI. The API key
    # never reaches the browser, and browser-provided identities are rejected.
    location = /scam-of-day {
        if ($args ~* "(^|&)userid=") { return 400; }
        rewrite ^ /scam-of-day?userId=staging-preview&lang=$arg_lang break;
        include /etc/nginx/snippets/noytrix-scam-of-day-key.conf;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /community/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    location = /api/events {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /auth { return 426; }
    location ^~ /iap { return 426; }
    location ^~ /billing/ { return 426; }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
